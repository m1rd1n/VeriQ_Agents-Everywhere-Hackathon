# Both model calls go through OpenRouter on a single key: vision extraction and
# the final evidence-only verdict. Keep this key server-side only.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_REASONING_MODEL=deepseek/deepseek-chat
# Sent to OpenRouter as HTTP-Referer for attribution. Optional.
OPENROUTER_SITE_URL=https://semakqr.local

# Scam database. Optional - PenipuMY issues keys by approval, and the service runs
# fine without one (the lookup reports itself unavailable and the offline sources
# below still fire). The path/param defaults match the shape documented on
# penipu.my/features; re-confirm against their docs once a key is issued.
PENIPUMY_API_KEY=
PENIPUMY_API_URL=https://penipu.my/api/v1/search
PENIPUMY_AUTH_HEADER=X-API-Key
# Set to "Bearer " (with the trailing space) if PenipuMY uses an Authorization header.
PENIPUMY_AUTH_PREFIX=
PENIPUMY_QUERY_PARAM=q

# Second signal: neural web search for very new accounts not yet in PenipuMY.
EXA_API_KEY=

# Account number that must always return the deterministic demo response.
# Matching ignores spaces and dashes, so "1581 1848 2136" also fires.
TEST_FLAGGED_ACCOUNT=158118482136

# Offline evidence sources. Both ship in the repo, need no key, and are read at
# startup - a missing or malformed file degrades that one source, nothing else.
LOCAL_FLAGGED_ACCOUNTS_PATH=data/local_flagged_accounts.json
BNM_ALERT_LIST_PATH=data/bnm_consumer_alert.csv
